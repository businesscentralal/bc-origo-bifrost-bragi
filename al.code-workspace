{
    "folders": [
        {
            "name": "Bifröst Bragi",
            "path": "app"
        },
        {
            "name": "Bifröst Bragi.Tests",
            "path": "test"
        },
        {
            "name": ".AL-Go",
            "path": ".AL-Go"
        }
    ],
    "settings": {
        "xml.validation.resolveExternalEntities": false,
        "xml.validation.schema.enabled": "never",
        "CRS.AlSubFolderName": "src",
        "CRS.ExtensionObjectNamePattern": "",
        "CRS.FileNamePattern": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
        "CRS.FileNamePatternExtensions": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
        "CRS.FileNamePatternPageCustomizations": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
        "CRS.RemoveSuffixFromFilename": true,
        "CRS.ObjectNameSuffix": "ori",
        "CRS.RenameWithGit": false,
        "cosmo-alpaca.viewMode": "technical",
        "cosmo-alpaca.activeView": "github",
        "al.codeAnalyzers": [
            "${CodeCop}",
            "${UICop}",
            "${AppSourceCop}"
        ],
        "al.enableCodeAnalysis": true,
        "al.backgroundCodeAnalysis": "Project",
        "al.enableCodeActions": true,
        "al.incrementalBuild": true,
        "al.packageCachePath": "./.alpackages",
        "al.namespaceTemplate": "Origo.Bifrost.Bragi",
        "dotnetAcquisitionExtension.existingDotnetPath": []
    },
    "extensions": {
        "recommendations": [
            "ms-dynamics-smb.al",
            "vscode-icons-team.vscode-icons"
        ]
    }
}
